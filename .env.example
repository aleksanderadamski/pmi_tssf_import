# Copy this file to .env and fill in real values. Never commit .env.

# --- ThoughtSpot ---
TS_HOST=pmi.thoughtspot.cloud
TS_USERNAME=
TS_PASSWORD=
TS_ORG_ID=0
# Name of the dataset as it appears in ThoughtSpot. The script resolves this
# to a GUID via metadata/search and caches it below — fill TS_DATASET_ID in
# once you have it, to skip the lookup on future runs.
TS_DATASET_NAME=Chapter Membership Dataset v2
TS_DATASET_ID=

# Value that marks a record "active" in the Isactive field, once confirmed
# by running fetch_members.py --inspect (see README). Common guesses: 1, true, Yes.
TS_ACTIVE_FLAG_VALUE=1

# --- Salesforce (JWT bearer flow) ---
# Connected App consumer key, and the integration user it's pre-authorized for.
SF_CLIENT_ID=
SF_USERNAME=
# The JWT signing key. Locally: SF_PRIVATE_KEY_FILE = path to the .pem.
# In a cloud run (Codespaces / mobile Claude Code / GitHub Actions) where no file
# ships, leave SF_PRIVATE_KEY_FILE blank and set SF_PRIVATE_KEY to the PEM
# contents as a secret instead (SF_PRIVATE_KEY wins if both are set).
SF_PRIVATE_KEY_FILE=./salesforce_private_key.pem
SF_PRIVATE_KEY=
# Use your org's REAL My Domain URL, NOT test.salesforce.com / login.salesforce.com
# — Salesforce dropped legacy hostname support for External Client Apps as of
# Spring '26 (JWT auth against the generic host fails with invalid_grant).
# Sandbox example:    https://<org>--<sandbox>.sandbox.my.salesforce.com
# Production example: https://<org>.my.salesforce.com
# (This is the my.salesforce.com host, NOT the my.salesforce-setup.com Setup UI host.)
SF_LOGIN_URL=
SF_API_VERSION=v61.0

# --- Optional: failure notifications (see reporting.py) ---
# If set, a JSON summary is POSTed here whenever any upsert fails. Works with a
# Slack/Teams incoming webhook or any generic endpoint. Leave blank to disable
# (the local output/upsert_failures_*.csv audit + non-zero exit still happen).
FAILURE_WEBHOOK_URL=
