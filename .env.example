 # Copy this file to .env and fill in real values. Never commit .env.

# --- ThoughtSpot ---
TS_HOST=pmi.thoughtspot.cloud
TS_USERNAME=C291-DEP
TS_PASSWORD= jsnfhcgdhfyehf&jd!kkhJ1
TS_ORG_ID=0
# Name of the dataset as it appears in ThoughtSpot. The script resolves this
# to a GUID via metadata/search and caches it below — fill TS_DATASET_ID in
# once you have it, to skip the lookup on future runs.
TS_DATASET_NAME=Chapter Membership Dataset v2 with Cert Details
TS_DATASET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Value that marks a record "active" in the Isactive field, once confirmed
# by running fetch_members.py --inspect (see README). Common guesses: 1, true, Yes.
TS_ACTIVE_FLAG_VALUE=1

# --- Salesforce (JWT bearer flow) ---
# Connected App consumer key, and the integration user it's pre-authorized for.
SF_CLIENT_ID=xxx
SF_USERNAME=xxx
# Path to the private key (.pem) matching the certificate uploaded to the Connected App.
SF_PRIVATE_KEY_FILE=./salesforce_private_key.pem
# Prawdziwy My Domain orgu (JWT audience + host). NIE login/test.salesforce.com,
# NIE host my.salesforce-setup.com (to UI Setup), NIE .lightning.force.com.
SF_LOGIN_URL=https://pmipolandchapter.my.salesforce.com
SF_API_VERSION=v61.0
